{
  "name": "angysguard-desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package-runtime": "node scripts/package-linux-runtime.cjs",
    "tauri": "tauri",
    "bundle:linux": "tauri build --bundles deb",
    "bundle:linux:deb": "tauri build --bundles deb",
    "bundle:linux:appimage": "env APPIMAGE_EXTRACT_AND_RUN=1 tauri build --bundles appimage",
    "bundle:windows": "tauri build --bundles nsis,msi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.2.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
