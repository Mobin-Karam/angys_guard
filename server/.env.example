# Copy these values into Runflare's environment-variable dashboard. Do not
# upload this file with real values and do not commit a populated .env file.

# Required: generate a unique random value of at least 32 characters.
ANGYSGUARD_SERVER_SECRET=

# Required in production: a path backed by Runflare persistent storage. The
# database holds account password verifiers and device metadata, so ephemeral
# container storage is not suitable.
ANGYSGUARD_DATABASE_PATH=./data/angysguard.db

# Optional: how long to retain completed command-audit records. The allowed
# range is one to ninety days; the 30-day default suits the ten-user pilot.
ANGYSGUARD_COMMAND_AUDIT_RETENTION_SECONDS=2592000

# Runflare normally sets this itself. Keep 8080 only for local/Docker use.
PORT=8080

# Configure only the provider(s) enabled for the managed test. Keep tokens on
# the server; never put them in the Tauri app or a device configuration file.
ANGYSGUARD_TELEGRAM_BOT_TOKEN=
ANGYSGUARD_TELEGRAM_WEBHOOK_SECRET=
ANGYSGUARD_BALE_BOT_TOKEN=
ANGYSGUARD_BALE_WEBHOOK_SECRET=
