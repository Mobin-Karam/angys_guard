# Create a Bale bot using @botfather in Bale. Never commit the real token.
BALE_BOT_TOKEN=PASTE_YOUR_BALE_BOT_TOKEN_HERE
# First run without this, send /id to the bot, then set it and restart.
BALE_CHAT_ID=

AUTO_ARM=false
ARM_DELAY=3
WARNING_SECONDS=5
INPUT_COOLDOWN=25
MOUSE_MOVE_THRESHOLD=35
LOCK_AFTER_WARNING=true
WARNING_VIDEO=true
CAMERA_SNAPSHOT_ON_INPUT=true
SCREEN_SNAPSHOT_ON_INPUT=true

CAMERA_INDEX=0
CAMERA_FPS=6
MOTION_ENABLED=true
MOTION_MIN_AREA=2200
MOTION_COOLDOWN=30

AUTO_PLAY_OWNER_VOICE=true

# Persian text-to-speech: Bale text -> synthesized Persian speech on laptop speakers
PERSIAN_TTS_ENABLED=true
# Voices: woman1..woman4, man1..man8, boy1
PERSIAN_TTS_VOICE=man2
PERSIAN_TTS_RATE_LIMIT=0.5
PERSIAN_TTS_MAX_CHARS=700
PERSIAN_TTS_NOTIFY=true
# If true, /say text is also shown in an already-open local Guard Chat.
PERSIAN_TTS_MIRROR_CHAT=false

INTERCOM_CHUNK_SECONDS=4
INTERCOM_MAX_SECONDS=90
LISTEN_DEFAULT_SECONDS=8

# Security hardening
# If the guard process/terminal disappears unexpectedly, request the normal OS lock.
LOCK_ON_GUARD_EXIT=true

# Protected Ctrl+C stop flow:
# 1) terminal asks for the owner-set PIN for 15 seconds;
# 2) Bale asks the authorized owner to confirm for 10 seconds;
# 3) wrong/timeout/deny locks the system and Guard keeps running.
STOP_AUTH_ENABLED=true
STOP_PIN_TIMEOUT=15
STOP_OWNER_CONFIRM_TIMEOUT=10
LOCK_ON_STOP_AUTH_FAILURE=true
# Remote unlock is disabled by default because it weakens local-login security.
# Linux uses loginctl unlock-session when enabled; Windows secure-logon unlock is not bypassed.
ALLOW_REMOTE_UNLOCK=false
# Enables confirmed suspend/reboot/shutdown controls from the authorized Bale chat.
ALLOW_REMOTE_POWER=false

# Local security-chat UI
CHAT_SECONDS=120
CHAT_ALLOW_REPLY=true
# auto detects Persian/Arabic/Hebrew vs Latin per message. Options: auto, rtl, ltr
CHAT_DIRECTION=auto
